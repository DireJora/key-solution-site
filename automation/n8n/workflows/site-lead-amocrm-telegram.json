        "parameters": {
          "jsCode": "const p=$input.first().json.body; const l=p?.lead;\nif(!l || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(l.id)) throw new Error('Invalid lead UUID');\nif(p.source!=='klyuchevoe-reshenie.ru') throw new Error('Invalid source');\nconst clean=(v,n)=>String(v||'').slice(0,n);\nconst marker='KS-SITE:'+l.id, name=marker+' '+clean(l.service,80);\nconst contact={name:clean(l.name,120)}; const raw=clean(l.contact,220);\nif(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(raw)) contact.custom_fields_values=[{field_code:'EMAIL',values:[{value:raw,enum_code:'WORK'}]}];\nelse if(/^\\+?[\\d ()-]{7,25}$/.test(raw)) contact.custom_fields_values=[{field_code:'PHONE',values:[{value:raw,enum_code:'WORK'}]}];\nconst embedded={contacts:[contact]}; if(l.company) embedded.companies=[{name:clean(l.company,180)}];\n// Plain lead creation avoids complex-add deduplication merging existing client cards.\n// Contact and company values are preserved in the private lead note.\nconst model={name,pipeline_id:11370274,status_id:89096506,request_id:l.id};\nconst clientId=l.analyticsConsent===true && /^\\d{1,32}$/.test(String(l.metrikaClientId||\"\")) ? String(l.metrikaClientId) : \"\";\nconst noteText=[marker, 'Имя: '+clean(l.name,120),'Компания: '+clean(l.company,180),'Контакт: '+raw,'Услуга: '+clean(l.service,120),'Страница: '+clean(l.landingPath,1000),'Сообщение: '+clean(l.message,4000),'Метки: '+JSON.stringify(l.utm||{}).slice(0,3500),'Вложения на закрытом сервере: '+(Array.isArray(l.attachments)?l.attachments.length:0)].concat(clientId ? ['ClientID Метрики: '+clientId] : []).join('\\n').slice(0,10000);\nlet contactKind='name', contactQuery='';\nif (/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(raw)) { contactKind='email'; contactQuery=raw.toLowerCase(); }\nelse if (/^\\+?[\\d ()-]{7,25}$/.test(raw)) { contactKind='phone'; contactQuery=raw; }\nelse { contact.name=(clean(l.name,90)||'Контакт с сайта')+' [site '+l.id.slice(0,8)+']'; contactQuery=contact.name; }\nreturn [{json:{marker,name,model,noteText,allow_write:p.allow_write===true,contactKind,contactQuery,contactModel:contact,notification:{name:clean(l.name,120),company:clean(l.company,180),contact:raw,service:clean(l.service,120),message:clean(l.message,700)}}}];"
