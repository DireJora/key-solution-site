      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const x=$json, overdue=Math.max(0,Math.floor(Date.now()/1000)-Number(x.task.complete_till||0));\nconst mins=Math.max(1,Math.floor(overdue/60));\nconst text=['⚠️ SLA просрочен','Задача связаться с новой заявкой не выполнена более '+mins+' мин.','Сделка: '+x.lead.name,'Ответственный amoCRM: '+x.task.responsible_user_id,'Открыть: https://krebrikus.amocrm.ru/leads/detail/'+x.lead.id].join('\\n');\nreturn {json:{...x,telegram_text:text.slice(0,3900)}};"
        },
