            "options": {
              "caseSensitive": true,
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "Lead still new",
                "leftValue": "={{ $json.eligible }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
