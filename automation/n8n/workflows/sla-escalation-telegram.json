      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "let b=$json; if(typeof b.data==='string'&&b.data) b=JSON.parse(b.data); if(b.body) b=b.body;\nconst task=$('Overdue SLA tasks').item.json;\nreturn {json:{task,lead:{id:b.id,name:b.name,pipeline_id:b.pipeline_id,status_id:b.status_id},eligible:b.pipeline_id===11370274&&b.status_id===89096506&&b.id===task.lead_id}};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          0
        ],
        "id": "Eligible lead",
        "name": "Eligible lead"
      },
