            "name": "Cloudflare Telegram Relay — Bearer"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "let b=$json; if(typeof b.data==='string'&&b.data) b=JSON.parse(b.data); if(b.body) b=b.body;\nif(b.ok!==true||!Number.isInteger(b.result?.message_id)) throw new Error('Telegram escalation not confirmed');\nconst x=$('Prepare escalation').item.json, telegram_message_id=b.result.message_id;\nreturn {json:{...x,telegram_message_id,note_body:[{note_type:'common',params:{text:x.marker+' | Telegram message '+telegram_message_id}}]}};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2200,
          120
