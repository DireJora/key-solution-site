            "name": "amoCRM — Ключевое решение"
          }
        },
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "let b=$input.first().json; if(typeof b.data==='string'&&b.data) b=JSON.parse(b.data); if(b.body) b=b.body;\nconst now=Math.floor(Date.now()/1000), exactLead=0;\nconst tasks=b?._embedded?.tasks||[];\nreturn tasks.filter(t=>t.entity_type==='leads'&&!t.is_completed&&Number(t.complete_till)<=now&&String(t.text||'').includes('KS-SLA:KS-SITE:')&&(!exactLead||t.entity_id===exactLead)).map(t=>({json:{task_id:t.id,lead_id:t.entity_id,responsible_user_id:t.responsible_user_id,complete_till:t.complete_till,text:t.text}}));"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          0
        ],
        "id": "Overdue SLA tasks",
        "name": "Overdue SLA tasks"
      },
      {
        "parameters": {
