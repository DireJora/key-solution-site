            "id": "L9Xprc4UN9m0Cgtb",
            "name": "amoCRM — Ключевое решение"
          }
        },
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "let b=$json; if(typeof b.data==='string'&&b.data) b=JSON.parse(b.data); if(b.body) b=b.body;\nconst ctx=$('Eligible lead').item.json, marker='KS-SLA-ALERT:'+ctx.task.task_id;\nconst notes=b?._embedded?.notes||[];\nconst decode=s=>String(s||'').replace(/&quot;/g,'\"').replace(/&amp;/g,'&');\nconst found=notes.some(n=>n.note_type==='common'&&decode(n.params?.text).includes(marker));\nreturn {json:{...ctx,marker,alert_exists:found}};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1320,
