# Включить индексацию только перед публикацией на основном домене.
PUBLIC_SITE_LIVE=false

# Для локальной проверки Метрики. На хостинге задаётся YANDEX_METRIKA_ID.
PUBLIC_YANDEX_METRIKA_ID=

# Эти значения задаются только в настройках опубликованного сайта.
YANDEX_METRIKA_ID=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
